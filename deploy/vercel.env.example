# Copy to ignored .env.cloud for migration/doctor, and Production-only Vercel
# environment settings for deployment. NEVER use VITE_ prefixes for secrets.
ZEROWALL_MODE=hosted
ZEROWALL_STORAGE=supabase
ZEROWALL_ROLE=web
ZEROWALL_DATA_DIR=/tmp/zerowall
ZEROWALL_PUBLIC_ORIGIN=https://YOUR-PROJECT.vercel.app
ZEROWALL_DIRECTOR_TOKEN=
# Supabase Connect > Session pooler, port 5432 (NOT transaction pooler 6543).
# URL-encode the password and append ?sslmode=require. Keep it server-side.
ZEROWALL_DATABASE_URL=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase server secret key or legacy service_role key, never anon/publishable.
SUPABASE_SECRET_KEY=
ZEROWALL_STORAGE_BUCKET=zerowall-private
NEBIUS_API_KEY=
TAVILY_API_KEY=
ZEROWALL_OPENROUTER_ENABLED=false
ZEROWALL_DIRECT_FREE_CONFIRMED=false
ZEROWALL_SEARCH_MONTHLY_LIMIT=900
