# Copy to .env.local and enter only keys for providers you intend to use.
# Never commit a populated local credentials file.
NEBIUS_API_KEY=

# Historical OpenRouter support is disabled by default.
ZEROWALL_OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=

# Direct council seats. Server-side only; never enter keys in the browser.
ZAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
GROQ_API_KEY=
# Set true only for confirmed free accounts without automatic paid charging.
ZEROWALL_DIRECT_FREE_CONFIRMED=false

# Tavily credential for collective web research; configured councils default to Search On.
# Cloud configuration is separate: see deploy/vercel.env.example and docs/operations/VERCEL_SUPABASE.md.
TAVILY_API_KEY=
