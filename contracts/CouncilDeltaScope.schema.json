{
  "$defs": {
    "CouncilOutputContract": {
      "additionalProperties": false,
      "properties": {
        "deliverable": {
          "default": "answer",
          "enum": [
            "answer",
            "explanation",
            "comparison",
            "ranked_approaches",
            "plan"
          ],
          "title": "Deliverable",
          "type": "string"
        },
        "requested_count": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Count"
        },
        "criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Criteria",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "CouncilOutputContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Claim Ids",
      "type": "array"
    },
    "within_claim_scope": {
      "title": "Within Claim Scope",
      "type": "boolean"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "output_contract": {
      "$ref": "#/$defs/CouncilOutputContract"
    }
  },
  "required": [
    "claim_ids",
    "within_claim_scope",
    "reason",
    "output_contract"
  ],
  "title": "CouncilDeltaScope",
  "type": "object"
}