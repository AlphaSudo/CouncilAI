{
  "$defs": {
    "AtomicClaim": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "pattern": "^C[1-9][0-9]?$",
          "title": "Ref",
          "type": "string"
        },
        "source_message_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source Message Id",
          "type": "string"
        },
        "source_unit_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Source Unit Ids",
          "type": "array"
        },
        "assertion": {
          "maxLength": 360,
          "minLength": 3,
          "title": "Assertion",
          "type": "string"
        },
        "scope": {
          "maxLength": 180,
          "minLength": 3,
          "title": "Scope",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Assumptions",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Dependencies",
          "type": "array"
        },
        "reasoning_kind": {
          "enum": [
            "definition",
            "deduction",
            "empirical",
            "proposal",
            "evaluation",
            "unclear"
          ],
          "title": "Reasoning Kind",
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "enum": [
              "quantitative",
              "causal",
              "comparative",
              "normative",
              "existential",
              "universal"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Properties"
        },
        "fidelity": {
          "enum": [
            "faithful_as_assessed",
            "uncertain",
            "compound_remaining"
          ],
          "title": "Fidelity",
          "type": "string"
        },
        "materiality": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Materiality",
          "type": "string"
        },
        "evidence_obligation": {
          "maxLength": 160,
          "minLength": 3,
          "title": "Evidence Obligation",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "source_message_id",
        "source_unit_ids",
        "assertion",
        "scope",
        "reasoning_kind",
        "fidelity",
        "materiality",
        "evidence_obligation"
      ],
      "title": "AtomicClaim",
      "type": "object"
    },
    "ClaimGroup": {
      "additionalProperties": false,
      "properties": {
        "refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Refs",
          "type": "array"
        },
        "relation": {
          "enum": [
            "equivalent_as_assessed",
            "related",
            "conflicting"
          ],
          "title": "Relation",
          "type": "string"
        },
        "reason": {
          "maxLength": 160,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "refs",
        "relation",
        "reason"
      ],
      "title": "ClaimGroup",
      "type": "object"
    },
    "ExtractionCoverage": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "assessment": {
          "enum": [
            "complete_as_assessed",
            "partial"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "omitted_material": {
          "maxLength": 1500,
          "title": "Omitted Material",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "assessment",
        "omitted_material"
      ],
      "title": "ExtractionCoverage",
      "type": "object"
    },
    "ReportedObservation": {
      "additionalProperties": false,
      "properties": {
        "source_message_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source Message Id",
          "type": "string"
        },
        "source_unit_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Unit Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "unsupported_self_report",
            "externally_attributed",
            "hypothetical",
            "quoted",
            "supplied_reference"
          ],
          "title": "Classification",
          "type": "string"
        },
        "trace_reference": {
          "default": "",
          "maxLength": 120,
          "title": "Trace Reference",
          "type": "string"
        },
        "reason": {
          "maxLength": 180,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "source_message_id",
        "source_unit_id",
        "classification",
        "reason"
      ],
      "title": "ReportedObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/AtomicClaim"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/ExtractionCoverage"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/ClaimGroup"
      },
      "maxItems": 4,
      "title": "Groups",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ReportedObservation"
      },
      "maxItems": 16,
      "title": "Observations",
      "type": "array"
    },
    "observation_coverage": {
      "maxLength": 300,
      "minLength": 3,
      "title": "Observation Coverage",
      "type": "string"
    },
    "observation_status": {
      "default": "partial",
      "enum": [
        "complete_as_assessed",
        "partial",
        "overflow"
      ],
      "title": "Observation Status",
      "type": "string"
    }
  },
  "required": [
    "claims",
    "coverage",
    "observation_coverage"
  ],
  "title": "AtomicExtraction",
  "type": "object"
}