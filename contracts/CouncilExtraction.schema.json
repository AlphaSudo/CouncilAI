{
  "$defs": {
    "CouncilAtomicClaim": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "pattern": "^C[1-9][0-9]?$",
          "title": "Ref",
          "type": "string"
        },
        "source_message_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source Message Id",
          "type": "string"
        },
        "source_unit_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Source Unit Ids",
          "type": "array"
        },
        "assertion": {
          "minLength": 3,
          "title": "Assertion",
          "type": "string"
        },
        "scope": {
          "minLength": 3,
          "title": "Scope",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Assumptions",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Dependencies",
          "type": "array"
        },
        "reasoning_kind": {
          "enum": [
            "definition",
            "deduction",
            "empirical",
            "proposal",
            "evaluation",
            "unclear"
          ],
          "title": "Reasoning Kind",
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "enum": [
              "quantitative",
              "causal",
              "comparative",
              "normative",
              "existential",
              "universal"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Properties"
        },
        "fidelity": {
          "enum": [
            "faithful_as_assessed",
            "uncertain",
            "compound_remaining"
          ],
          "title": "Fidelity",
          "type": "string"
        },
        "materiality": {
          "minLength": 3,
          "title": "Materiality",
          "type": "string"
        },
        "evidence_obligation": {
          "minLength": 3,
          "title": "Evidence Obligation",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "source_message_id",
        "source_unit_ids",
        "assertion",
        "scope",
        "reasoning_kind",
        "fidelity",
        "materiality",
        "evidence_obligation"
      ],
      "title": "CouncilAtomicClaim",
      "type": "object"
    },
    "CouncilAuditDescriptor": {
      "additionalProperties": false,
      "properties": {
        "claim_ref": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Claim Ref",
          "type": "string"
        },
        "source_unit_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Source Unit Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "calculation",
            "resource",
            "citation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "minLength": 3,
          "title": "Scope",
          "type": "string"
        },
        "expression": {
          "default": "",
          "title": "Expression",
          "type": "string"
        },
        "quantities": {
          "items": {
            "$ref": "#/$defs/CouncilAuditQuantity"
          },
          "maxItems": 8,
          "title": "Quantities",
          "type": "array"
        },
        "output_unit": {
          "default": "1",
          "title": "Output Unit",
          "type": "string"
        },
        "output_kind": {
          "default": "number",
          "title": "Output Kind",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Value"
        },
        "absolute_tolerance": {
          "default": "0",
          "title": "Absolute Tolerance",
          "type": "string"
        },
        "boundary": {
          "default": "",
          "title": "Boundary",
          "type": "string"
        },
        "denominator": {
          "default": "",
          "title": "Denominator",
          "type": "string"
        },
        "numerator": {
          "default": "",
          "title": "Numerator",
          "type": "string"
        },
        "is_ratio": {
          "default": false,
          "title": "Is Ratio",
          "type": "boolean"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/CouncilResourceTerm"
          },
          "maxItems": 8,
          "title": "Resources",
          "type": "array"
        },
        "missing_terms": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Missing Terms",
          "type": "array"
        },
        "reference": {
          "default": "",
          "title": "Reference",
          "type": "string"
        },
        "claimed_support": {
          "default": "",
          "title": "Claimed Support",
          "type": "string"
        }
      },
      "required": [
        "claim_ref",
        "source_unit_ids",
        "kind",
        "scope"
      ],
      "title": "CouncilAuditDescriptor",
      "type": "object"
    },
    "CouncilAuditQuantity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,23}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "default": "1",
          "title": "Unit",
          "type": "string"
        },
        "quantity_kind": {
          "default": "number",
          "title": "Quantity Kind",
          "type": "string"
        },
        "basis": {
          "minLength": 3,
          "title": "Basis",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "name",
        "basis"
      ],
      "title": "CouncilAuditQuantity",
      "type": "object"
    },
    "CouncilClaimGroup": {
      "additionalProperties": false,
      "properties": {
        "refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Refs",
          "type": "array"
        },
        "relation": {
          "enum": [
            "equivalent_as_assessed",
            "related",
            "conflicting"
          ],
          "title": "Relation",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "refs",
        "relation",
        "reason"
      ],
      "title": "CouncilClaimGroup",
      "type": "object"
    },
    "CouncilExtractionCoverage": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "assessment": {
          "enum": [
            "complete_as_assessed",
            "partial"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "omitted_material": {
          "title": "Omitted Material",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "assessment",
        "omitted_material"
      ],
      "title": "CouncilExtractionCoverage",
      "type": "object"
    },
    "CouncilFamily": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "mechanism": {
          "minLength": 3,
          "title": "Mechanism",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        },
        "assumptions": {
          "minLength": 3,
          "title": "Assumptions",
          "type": "string"
        },
        "resources": {
          "minLength": 3,
          "title": "Resources",
          "type": "string"
        },
        "distinguishing_test": {
          "minLength": 3,
          "title": "Distinguishing Test",
          "type": "string"
        }
      },
      "required": [
        "name",
        "mechanism",
        "refs",
        "assumptions",
        "resources",
        "distinguishing_test"
      ],
      "title": "CouncilFamily",
      "type": "object"
    },
    "CouncilInventoryItem": {
      "additionalProperties": false,
      "properties": {
        "source_message_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source Message Id",
          "type": "string"
        },
        "source_unit_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Source Unit Ids",
          "type": "array"
        },
        "category": {
          "enum": [
            "approach",
            "quantity",
            "equation",
            "citation",
            "constraint",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "description": {
          "minLength": 3,
          "title": "Description",
          "type": "string"
        },
        "claim_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Claim Refs",
          "type": "array"
        }
      },
      "required": [
        "source_message_id",
        "source_unit_ids",
        "category",
        "description"
      ],
      "title": "CouncilInventoryItem",
      "type": "object"
    },
    "CouncilOutputContract": {
      "additionalProperties": false,
      "properties": {
        "deliverable": {
          "default": "answer",
          "enum": [
            "answer",
            "explanation",
            "comparison",
            "ranked_approaches",
            "plan"
          ],
          "title": "Deliverable",
          "type": "string"
        },
        "requested_count": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Count"
        },
        "criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Criteria",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "CouncilOutputContract",
      "type": "object"
    },
    "CouncilReportedObservation": {
      "additionalProperties": false,
      "properties": {
        "source_message_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source Message Id",
          "type": "string"
        },
        "source_unit_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Unit Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "unsupported_self_report",
            "externally_attributed",
            "hypothetical",
            "quoted",
            "supplied_reference"
          ],
          "title": "Classification",
          "type": "string"
        },
        "trace_reference": {
          "default": "",
          "title": "Trace Reference",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "source_message_id",
        "source_unit_id",
        "classification",
        "reason"
      ],
      "title": "CouncilReportedObservation",
      "type": "object"
    },
    "CouncilResourceTerm": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "maintenance",
            "static_requirement"
          ],
          "title": "Direction",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "default": "unknown",
          "title": "Unit",
          "type": "string"
        },
        "basis": {
          "minLength": 3,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "name",
        "direction",
        "basis"
      ],
      "title": "CouncilResourceTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/CouncilAtomicClaim"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CouncilExtractionCoverage"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/CouncilClaimGroup"
      },
      "maxItems": 4,
      "title": "Groups",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/CouncilReportedObservation"
      },
      "maxItems": 16,
      "title": "Observations",
      "type": "array"
    },
    "observation_coverage": {
      "minLength": 1,
      "title": "Observation Coverage",
      "type": "string"
    },
    "observation_status": {
      "default": "partial",
      "enum": [
        "complete_as_assessed",
        "partial",
        "overflow"
      ],
      "title": "Observation Status",
      "type": "string"
    },
    "output_contract": {
      "$ref": "#/$defs/CouncilOutputContract"
    },
    "inventory": {
      "items": {
        "$ref": "#/$defs/CouncilInventoryItem"
      },
      "maxItems": 16,
      "title": "Inventory",
      "type": "array"
    },
    "inventory_status": {
      "default": "partial",
      "enum": [
        "complete_as_assessed",
        "partial",
        "overflow"
      ],
      "title": "Inventory Status",
      "type": "string"
    },
    "inventory_limitations": {
      "minLength": 1,
      "title": "Inventory Limitations",
      "type": "string"
    },
    "audits": {
      "items": {
        "$ref": "#/$defs/CouncilAuditDescriptor"
      },
      "maxItems": 8,
      "title": "Audits",
      "type": "array"
    },
    "families": {
      "items": {
        "$ref": "#/$defs/CouncilFamily"
      },
      "maxItems": 8,
      "title": "Families",
      "type": "array"
    }
  },
  "required": [
    "claims",
    "coverage",
    "observation_coverage",
    "output_contract",
    "inventory_limitations"
  ],
  "title": "CouncilExtraction",
  "type": "object"
}