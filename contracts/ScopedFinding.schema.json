{
  "$defs": {
    "CandidateTest": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "maxLength": 180,
          "minLength": 3,
          "title": "Method",
          "type": "string"
        },
        "disconfirming_outcome": {
          "maxLength": 140,
          "minLength": 3,
          "title": "Disconfirming Outcome",
          "type": "string"
        },
        "baseline": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Baseline",
          "type": "string"
        },
        "threshold_basis": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Threshold Basis",
          "type": "string"
        },
        "limitations": {
          "maxLength": 160,
          "minLength": 3,
          "title": "Limitations",
          "type": "string"
        }
      },
      "required": [
        "method",
        "disconfirming_outcome",
        "baseline",
        "threshold_basis",
        "limitations"
      ],
      "title": "CandidateTest",
      "type": "object"
    },
    "ModelReviewCheck": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 40,
          "minLength": 3,
          "pattern": "^[a-z][a-z_ -]+$",
          "title": "Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "maxLength": 700,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "category",
        "status",
        "reason"
      ],
      "title": "ModelReviewCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Claim Id",
      "type": "string"
    },
    "claim_revision": {
      "minimum": 1,
      "title": "Claim Revision",
      "type": "integer"
    },
    "steelman": {
      "maxLength": 500,
      "minLength": 3,
      "title": "Steelman",
      "type": "string"
    },
    "objection": {
      "maxLength": 1000,
      "minLength": 3,
      "title": "Objection",
      "type": "string"
    },
    "candidate_test": {
      "maxLength": 700,
      "minLength": 3,
      "title": "Candidate Test",
      "type": "string"
    },
    "minimum_resolution": {
      "maxLength": 700,
      "minLength": 3,
      "title": "Minimum Resolution",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ModelReviewCheck"
      },
      "maxItems": 7,
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Evidence Ids",
      "type": "array"
    },
    "target": {
      "maxLength": 120,
      "minLength": 3,
      "title": "Target",
      "type": "string"
    },
    "in_scope_reason": {
      "maxLength": 160,
      "minLength": 3,
      "title": "In Scope Reason",
      "type": "string"
    },
    "concern_kind": {
      "enum": [
        "contradiction",
        "missing_evidence",
        "condition",
        "operational_limitation",
        "residual_risk"
      ],
      "title": "Concern Kind",
      "type": "string"
    },
    "test": {
      "$ref": "#/$defs/CandidateTest"
    }
  },
  "required": [
    "claim_id",
    "claim_revision",
    "steelman",
    "objection",
    "candidate_test",
    "minimum_resolution",
    "checks",
    "target",
    "in_scope_reason",
    "concern_kind",
    "test"
  ],
  "title": "ScopedFinding",
  "type": "object"
}